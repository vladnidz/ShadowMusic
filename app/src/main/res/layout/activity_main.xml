<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shadow_black"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ ShadowMusic"
        android:textColor="@color/neon_green"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="1-Click YouTube Music Bridge to Huawei Watch 3 Pro"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@color/shadow_card_bg"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="СТАТУС СОПРЯЖЕНИЯ"
            android:textColor="@color/neon_green_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWatchStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="⌚ Huawei Watch 3 Pro: В сети"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Канал: Wi-Fi Direct + Bluetooth Standby"
            android:textColor="@color/neon_green"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnTestWatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/neon_green"
        android:text="Проверить связь с часами"
        android:textColor="@color/shadow_black"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Как пользоваться:\n1. Откройте любой трек в YT Music ReVanced\n2. Нажмите 'Поделиться' ➔ '⌚ Отправить на Huawei Watch'\n3. Трек мгновенно сохранится в памяти часов с HD-обложкой"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

</LinearLayout>
