<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShadowMusic" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/shadow_black</item>
        <item name="android:statusBarColor">@color/shadow_black</item>
        <item name="android:navigationBarColor">@color/shadow_black</item>
        <item name="colorPrimary">@color/neon_green</item>
        <item name="colorOnPrimary">@color/shadow_black</item>
        <item name="colorSurface">@color/shadow_card_bg</item>
        <item name="colorOnSurface">@color/text_white</item>
    </style>

    <style name="Theme.ShadowMusic.Translucent" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
